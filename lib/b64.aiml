# museum.b64 — base64 decoding for HTTP Basic auth.
#
# TODO(replace with base64.decode builtin): aiml has no base64 builtin on
# mem-v3-compiler yet (it is being added on aiml branch
# feature/identity-builtins-memv3).  This stopgap decodes the standard
# alphabet into a string; it exists only for `Authorization: Basic …`.

- namespace: museum.b64

# Decodes standard base64 (with or without padding) whose decoded bytes are
# printable ASCII (32..126) — what Basic credentials are in practice.  Returns
# "" for invalid input or non-ASCII output.  (A decoded byte is mapped to its
# character through a table: aiml has no chr(), and assembling the bytes in a
# buffer and reading it back as a string returns an unmanaged string under
# memV3 — reported as an aiml gap.)
- def:
    name: decode
    args: [[text, string]]
    return: string
    body:
      - decl: [alphabet, string, "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"]
      - decl: [clean, string, { call: [text.trim] }]
      - set: [clean, { call: [clean.replace, "=", ""] }]
      - decl: [count, i32, clean.len]
      - if:
          condition: { eq: [{ "%": [count, 4] }, 1] }
          then:
            - return: [""]
      - decl: [printable, string, " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"]
      - decl: [out, string, ""]
      - decl: [acc, i32, 0]
      - decl: [bits, i32, 0]
      - decl: [idx, i32, 0]
      - while:
          condition: { lt: [idx, count] }
          body:
            - decl: [one, string, { call: [clean.substr, idx, 1] }]
            - decl: [val, i32, { call: [alphabet.index_of, one] }]
            - if:
                condition: { lt: [val, 0] }
                then:
                  - return: [""]
            - set: [acc, { bor: [{ shl: [{ band: [acc, 65535] }, 6] }, val] }]
            - set: [bits, { +: [bits, 6] }]
            - if:
                condition: { ge: [bits, 8] }
                then:
                  - set: [bits, { -: [bits, 8] }]
                  - decl: [byte_val, i32, { band: [{ shr: [acc, bits] }, 255] }]
                  - if:
                      condition: { or: [{ lt: [byte_val, 32] }, { gt: [byte_val, 126] }] }
                      then:
                        - return: [""]
                  - decl: [glyph, string, { call: [printable.substr, { -: [byte_val, 32] }, 1] }]
                  - set: [out, "${out}${glyph}"]
            - set: [idx, { +: [idx, 1] }]
      - return: [out]
