# kontor — artifact repository, OCI registry and webhook source for the
# exodus/cosmos ecosystem (doc/ecosystem.md is the contract).
#
#   aiml kontor.aiml -- [port] [data_dir] [--admin-token-file <path>]
#        (defaults: 8081 ./data; KONTOR_ADMIN_TOKEN works like the file)
#
# Repositories
#   generic   any file at any path, content-addressed (sha256, deduplicated)
#   exodus    Exodus projects: exodus.json manifest + package per version;
#             the manifests feed the dependency graph
#   oci       OCI Distribution v1.1 registry under /v2/ (images, cosmos
#             run-layers artifacts)
#
# Every path below /api/ also exists under /api/v1/; /generic/ and /exodus/
# keep working and have /api/v1/ aliases.  See README.md for the full API.

- import: "lib/api.aiml"

- decl: [g_api, ptr<kontor.api.RepositoryApi>]
# The HTTP server runs one thread per connection; kontor's state (graph
# snapshot, files written in several steps) is guarded by one lock, held for
# the whole handler.  Webhook delivery runs on its own thread outside it.
- decl: [g_lock, lock]

# Route handlers: srv.route needs free functions, so each one wraps the
# request in an Exchange (owned here) and lends it to the RepositoryApi.

- def:
    name: wrap
    args: [[req, http_request_handle], [resp, http_response_handle]]
    return: ptr<kontor.http.Exchange>
    body:
      - decl: [xch, ptr<kontor.http.Exchange>, { new: kontor.http.Exchange }]
      - set: [xch.req, req]
      - set: [xch.resp, resp]
      - return: [xch]

- def:
    name: on_health
    args: [[req, http_request_handle], [resp, http_response_handle]]
    body:
      - call: [g_lock.acquire]
      - decl: [xch, ptr<kontor.http.Exchange>, { call: [wrap, req, resp] }]
      - call: [g_api.health, xch]
      - call: [g_lock.release]

- def:
    name: on_graph
    args: [[req, http_request_handle], [resp, http_response_handle]]
