      - call: [g_lock.release]

- def:
    name: on_not_found
    args: [[req, http_request_handle], [resp, http_response_handle]]
    body:
      - call: [g_lock.acquire]
      - decl: [xch, ptr<kontor.http.Exchange>, { call: [wrap, req, resp] }]
      - call: [xch.error, 404, "no such endpoint"]
      - call: [g_lock.release]

# Admin bootstrap secret: --admin-token-file <path> or KONTOR_ADMIN_TOKEN.
# Never logged.  Returns "" when none is configured.
- def:
    name: bootstrap_secret
    return: string
    body:
      - decl: [idx, i32, 1]
      - decl: [count, i32, 64]
      - while:
          condition: { lt: [idx, count] }
          body:
            - decl: [flag, string, { call: [sys.get_arg, idx] }]
            - if: { condition: { or: [{ eq: [flag, null] }, { eq: [flag.len, 0] }] }, then: [{ set: [count, 0] }] }
            - if:
                condition: { eq: [flag, "--admin-token-file"] }
                then:
                  - decl: [token_file, string, { call: [sys.get_arg, { +: [idx, 1] }] }]
                  - decl: [content, string, { call: [io.read_file, token_file] }]
                  - if:
                      condition: { eq: [content, null] }
                      then:
                        - return: [""]
                  - return: [{ call: [content.trim] }]
            - set: [idx, { +: [idx, 1] }]
      - decl: [envm, map<string:string>, sys.env]
      - if:
          condition: { call: [envm.contains, "KONTOR_ADMIN_TOKEN"] }
          then:
            - decl: [from_env, string, { call: [envm.get, "KONTOR_ADMIN_TOKEN"] }]
            - return: [{ call: [from_env.trim] }]
      - return: [""]

# Value of `--<flag> <value>` ("" when absent).
- def:
    name: flag_value
    args: [[flag, string]]
    return: string
    body:
      - decl: [idx, i32, 1]
      - while:
          condition: { lt: [idx, 64] }
          body:
            - decl: [word, string, { call: [sys.get_arg, idx] }]
            - if: { condition: { or: [{ eq: [word, null] }, { eq: [word.len, 0] }] }, then: [{ return: [""] }] }
            - if:
                condition: { eq: [word, flag] }
                then:
                  - decl: [value, string, { call: [sys.get_arg, { +: [idx, 1] }] }]
                  - if: { condition: { eq: [value, null] }, then: [{ return: [""] }] }
                  - return: [value]
            - set: [idx, { +: [idx, 1] }]
      - return: [""]

# Where the web UI may be (web_ui.md FW-11), first that exists wins:
# --ui-dir, $KONTOR_UI_DIR, <binary>/../share/kontor/ui, ./ui/dist.
- def:
    name: ui_candidates
    return: list<string>
    body:
      - decl: [out, list<string>, []]
      - decl: [flagged, string, { call: [flag_value, "--ui-dir"] }]
      - if:
          condition: { gt: [flagged.len, 0] }
          then:
            - call: [out.push, flagged]
            - return: [out]
      - decl: [envm, map<string:string>, sys.env]
      - if:
          condition: { call: [envm.contains, "KONTOR_UI_DIR"] }
          then:
            - call: [out.push, { call: [envm.get, "KONTOR_UI_DIR"] }]
            - return: [out]
      - decl: [self, string, { call: [sys.get_arg, 0] }]
      - if:
          condition: { and: [{ neq: [self, null] }, { gt: [self.len, 0] }] }
          then:
            - decl: [real, path, { call: [io.realpath, self] }]
            - decl: [bin_dir, path, { call: [real.parent] }]
            - call: [out.push, "${bin_dir}/../share/kontor/ui"]
      - call: [out.push, "./ui/dist"]
      - return: [out]

# Positional argument `want` (1-based), skipping --flag value pairs.
- def:
    name: positional
    args: [[want, i32]]
    return: string
    body:
      - decl: [idx, i32, 1]
      - decl: [seen, i32, 0]
      - decl: [count, i32, 64]
      - while:
          condition: { lt: [idx, count] }
          body:
            - decl: [word, string, { call: [sys.get_arg, idx] }]
            - if: { condition: { or: [{ eq: [word, null] }, { eq: [word.len, 0] }] }, then: [{ return: [""] }] }
            - if:
                condition: { eq: [{ call: [word.starts_with, "--"] }, 1] }
                then:
                  - set: [idx, { +: [idx, 2] }]
                else:
                  - set: [seen, { +: [seen, 1] }]
                  - if:
                      condition: { eq: [seen, want] }
                      then:
                        - return: [word]
                  - set: [idx, { +: [idx, 1] }]
      - return: [""]

- def:
    name: main
    return: i32
    body:
      - decl: [port, i32, 8081]
      - decl: [arg_port, string, { call: [positional, 1] }]
      - if:
          condition: { gt: [arg_port.len, 0] }
          then:
            - set: [port, arg_port]
      - decl: [data_dir, string, { call: [positional, 2] }]
      - if:
          condition: { eq: [data_dir.len, 0] }
          then:
            - set: [data_dir, "./data"]
      - call: [io.mkdir_all, "${data_dir}/exodus"]
      - call: [io.mkdir_all, "${data_dir}/tmp/spool"]
      - call: [g_lock.init]

      # public_url (for webhook payloads) from kontor.yaml, default http://localhost:<port>
      - decl: [public_url, string, "http://localhost:${port}"]
      - if:
          condition: { call: [io.exists, "${data_dir}/kontor.yaml"] }
          then:
            - decl: [cfg, ptr<yaml_doc>, { call: [yaml.parse_file, "${data_dir}/kontor.yaml"] }]
            - decl: [configured, string, { call: [yaml.scalar, { call: [yaml.get, { call: [yaml.root, cfg] }, "public_url"] }] }]
            - call: [yaml.free, cfg]
            - if:
                condition: { gt: [configured.len, 0] }
                then:
                  - set: [public_url, configured]

      - set: [g_api, { new: kontor.api.RepositoryApi }]
      - decl: [problem, string, { call: [g_api.setup, data_dir, public_url] }]
      - if:
          condition: { gt: [problem.len, 0] }
          then:
            - call: [log.error, "kontor.yaml: ${problem}"]
            - return: [2]
      - call: [g_api.setup_ui, { call: [ui_candidates] }]
      - decl: [secret, string, { call: [bootstrap_secret] }]
      - if:
          condition: { gt: [secret.len, 0] }
          then:
            - if:
                condition: { lt: [secret.len, 32] }
                then:
                  - call: [log.error, "admin bootstrap token must have at least 32 characters"]
                  - return: [2]
            - call: [g_api.acl.ensure_admin_token, secret]
            - call: [log.info, "admin bootstrap token installed (id bootstrap)"]

      - decl: [worker, thread_handle]
      - set: [worker, { spawn: [kontor.hooks.worker_loop, data_dir, public_url] }]
      - call: [worker.detach]
      - decl: [scheduler, thread_handle]
      - set: [scheduler, { spawn: [retention_loop] }]
      - call: [scheduler.detach]

      - decl: [srv, http_server_handle]
      - set: [srv, { call: [http.server, "0.0.0.0", port] }]
      - call: [srv.set_max_body, 1073741824]
      # Every body is spooled to a file (registry blobs can be large); 10 GiB cap.
      - call: [srv.set_spool, "${data_dir}/tmp/spool", 1, 10737418240]
      - call: [srv.set_timeout, 120]
      - call: [srv.route, "GET", "/api/health", on_health]
      - call: [srv.route, "GET", "/api/v1/health", on_health]
      - call: [srv.route, "GET", "/api/graph", on_graph]
      - call: [srv.route, "GET", "/api/v1/graph", on_graph]
      - call: [srv.route, "GET", "/api/impact", on_impact]
      - call: [srv.route, "GET", "/api/v1/impact", on_impact]
      - call: [srv.route, "PUT", "/exodus/:name/:version/exodus.json", on_manifest_put]
      - call: [srv.route, "GET", "/exodus/:name/:version/exodus.json", on_manifest_get]
      - call: [srv.route, "PUT", "/exodus/:name/:version/package", on_package_put]
      - call: [srv.route, "GET", "/exodus/:name/:version/package", on_package_get]
      - call: [srv.route, "PUT", "/generic/*", on_generic_put]
      - call: [srv.route, "GET", "/generic/*", on_generic_get]
      - call: [srv.route, "PUT", "/api/v1/exodus/:name/:version/exodus.json", on_manifest_put]
      - call: [srv.route, "GET", "/api/v1/exodus/:name/:version/exodus.json", on_manifest_get]
      - call: [srv.route, "PUT", "/api/v1/exodus/:name/:version/package", on_package_put]
      - call: [srv.route, "GET", "/api/v1/exodus/:name/:version/package", on_package_get]
      - call: [srv.route, "PUT", "/api/v1/generic/*", on_generic_put]
      - call: [srv.route, "GET", "/api/v1/generic/*", on_generic_get]
      - call: [srv.route, "GET", "/api/v1/whoami", on_whoami]
      - call: [srv.route, "GET", "/api/v1/sso/saml/login", on_sso_login]
      - call: [srv.route, "POST", "/api/v1/sso/saml/acs", on_sso_acs]
      - call: [srv.route, "POST", "/api/v1/tokens", on_token_create]
      - call: [srv.route, "GET", "/api/v1/tokens", on_token_list]
      - call: [srv.route, "DELETE", "/api/v1/tokens/:id", on_token_revoke]
      - call: [srv.route, "POST", "/api/v1/users", on_user_put]
      - call: [srv.route, "GET", "/api/v1/users", on_user_list]
      - call: [srv.route, "DELETE", "/api/v1/users/:name", on_user_delete]
      - call: [srv.route, "POST", "/api/v1/webhooks", on_hook_create]
      - call: [srv.route, "GET", "/api/v1/webhooks", on_hook_list]
      - call: [srv.route, "DELETE", "/api/v1/webhooks/:id", on_hook_delete]
      - call: [srv.route, "POST", "/api/v1/webhooks/:id/test", on_hook_test]
      - call: [srv.route, "GET", "/api/v1/webhooks/:id/deliveries", on_hook_deliveries]
      - call: [srv.route, "POST", "/api/v1/webhooks/:id/deliveries/:delivery/redeliver", on_hook_redeliver]
      - call: [srv.route, "GET", "/api/v1/layers/:pipeline", on_layer_runs]
      - call: [srv.route, "GET", "/api/v1/layers/:pipeline/:run", on_layer_run]
      - call: [srv.route, "GET", "/v2/*", on_v2_read]
      - call: [srv.route, "HEAD", "/v2/*", on_v2_read]
      - call: [srv.route, "POST", "/v2/*", on_v2_post]
      - call: [srv.route, "PATCH", "/v2/*", on_v2_patch]
      - call: [srv.route, "PUT", "/v2/*", on_v2_put]
      - call: [srv.route, "DELETE", "/v2/*", on_v2_delete]
      - call: [srv.route, "GET", "/api/v1/catalog", on_catalog]
      - call: [srv.route, "GET", "/api/v1/catalog/exodus/:name", on_catalog_project]
      - call: [srv.route, "GET", "/api/v1/catalog/generic", on_catalog_generic]
      - call: [srv.route, "GET", "/api/v1/retention", on_retention_get]
      - call: [srv.route, "PUT", "/api/v1/retention", on_retention_put]
      - call: [srv.route, "POST", "/api/v1/retention/preview", on_retention_preview]
      - call: [srv.route, "POST", "/api/v1/retention/run", on_retention_run]
      - call: [srv.route, "GET", "/api/v1/retention/runs", on_retention_runs]
      - call: [srv.route, "GET", "/api/v1/protected", on_protected_list]
      - call: [srv.route, "PUT", "/api/v1/protected", on_protected_put]
      - call: [srv.route, "DELETE", "/api/v1/protected", on_protected_delete]
      - call: [srv.route, "DELETE", "/exodus/:name/:version", on_exodus_delete]
      - call: [srv.route, "DELETE", "/api/v1/exodus/:name/:version", on_exodus_delete]
      - call: [srv.route, "GET", "/api/v1/settings", on_settings_get]
      - call: [srv.route, "PUT", "/api/v1/settings", on_settings_put]
      - call: [srv.route, "POST", "/api/v1/sessions", on_session_create]
      - call: [srv.route, "GET", "/", on_ui]
      - call: [srv.route, "GET", "/ui", on_ui]
      - call: [srv.route, "GET", "/ui/*", on_ui]
      - call: [srv.route, "*", "/*", on_not_found]
      - call: [log.info, "kontor listening on :${port}, data in ${data_dir}"]
      - call: [srv.start]
      - return: [0]
