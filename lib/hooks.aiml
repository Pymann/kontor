# museum.hooks — webhook subscriptions and at-least-once delivery
# (contract doc/ecosystem.md §4).
#
# Storage below <data>/hooks/ (one file per record, written atomically):
#   subs/<id>                       {"id","url","secret","events":[…],"created_ms"}
#   queue/<delivery>                {"delivery","sub","event","attempt","next_ms"}  — due work
#   log/<sub>/<delivery>            {"delivery","event","attempts","status","last_code","updated_ms"}
#   log/<sub>/<delivery>.body       the exact payload bytes (signed as sent; kept for redelivery)
#
# A delivery worker thread (worker_loop) polls queue/ and POSTs due entries.
# 2xx = delivered.  Anything else (incl. connection errors) is retried after
# 1 s, 5 s, 30 s, 2 min, 10 min; after the fifth retry the delivery is
# "failed".  Handlers only ever ADD queue files and the worker owns them after
# that, so the two never write the same file.

- namespace: museum.hooks

- import: "text.aiml"
- import: "store.aiml"
- import: "auth.aiml"

# Backoff before retry `attempt` (1-based number of failed attempts so far), ms.
- def:
    name: backoff_ms
    args: [[attempt, i32]]
    return: i64
    body:
      - decl: [steps, list<i64>, [1000, 5000, 30000, 120000, 600000]]
      - if:
          condition: { or: [{ lt: [attempt, 1] }, { gt: [attempt, steps.len] }] }
          then:
            - return: [-1]
      - return: [{ call: [steps.get, { -: [attempt, 1] }] }]

- class:
    name: WebhookHub
    members:
      - [data_dir, string, "./data", { access: public }]
      - [public_url, string, "", { access: public }]
    methods:
      - def:
          name: hooks_dir
          return: string
          body:
            - return: ["${<.data_dir}/hooks"]

      # ── subscriptions ────────────────────────────────────────────────────
      # Creates a subscription; returns its id, or "" + sets `err` text via the
      # returned "!message" form.
      - def:
          name: subscribe
          args: [[target, string], [secret, string], [events_csv, string]]
          return: string
          body:
            - if:
                condition: { and: [{ eq: [{ call: [target.starts_with, "http://"] }, 0] }, { eq: [{ call: [target.starts_with, "https://"] }, 0] }] }
                then:
                  - return: ["!url must start with http:// or https://"]
            - if:
                condition: { lt: [secret.len, 16] }
                then:
                  - return: ["!secret must have at least 16 characters"]
            - if:
                condition: { eq: [events_csv.len, 0] }
                then:
                  - set: [events_csv, "*"]
            - decl: [sub_id, string, { call: [math.random_hex, 8] }]
            - decl: [now_ms, i64, { call: [time.now] }]
            - decl: [body, string, "{\"id\":\"${sub_id}\",\"url\":${{ call: [museum.text.json_str, target] }},\"secret\":${{ call: [museum.text.json_str, secret] }},\"events\":${{ call: [museum.auth.csv_json, events_csv] }},\"created_ms\":${now_ms}}"]
            - call: [museum.store.write_text, <.data_dir, "${{ call: [<.hooks_dir] }}/subs", sub_id, body]
            - return: [sub_id]

      - def:
          name: sub_path
          args: [[sub_id, string]]
          return: string
          body:
            - return: ["${{ call: [<.hooks_dir] }}/subs/${sub_id}"]

      - def:
          name: exists
          args: [[sub_id, string]]
          return: i32
          body:
            - if:
                condition: { or: [{ eq: [{ call: [museum.auth.valid_name, sub_id] }, 0] }, { not: [{ call: [io.exists, { call: [<.sub_path, sub_id] }] }] }] }
                then:
                  - return: [0]
            - return: [1]

      - def:
          name: unsubscribe
          args: [[sub_id, string]]
          return: i32
          body:
            - if:
                condition: { eq: [{ call: [<.exists, sub_id] }, 0] }
                then:
                  - return: [0]
            - call: [io.remove, { call: [<.sub_path, sub_id] }]
            - return: [1]

      # Subscriptions as JSON — the secret is never returned.
      - def:
          name: subs_json
          return: string
          body:
            - decl: [ids, list<string>, { call: [museum.store.list_files, "${{ call: [<.hooks_dir] }}/subs"] }]
            - decl: [out, string, ""]
            - decl: [idx, i32, 0]
            - while:
                condition: { lt: [idx, ids.len] }
                body:
                  - decl: [sub_id, string, { call: [ids.get, idx] }]
                  - decl: [doc, ptr<yaml_doc>, { call: [yaml.parse_file, { call: [<.sub_path, sub_id] }] }]
                  - decl: [root, ptr<yaml_node>, { call: [yaml.root, doc] }]
                  - decl: [target, string, { call: [yaml.scalar, { call: [yaml.get, root, "url"] }] }]
                  - decl: [events_csv, string, { call: [museum.auth.seq_csv, { call: [yaml.get, root, "events"] }] }]
                  - decl: [created, string, { call: [yaml.scalar, { call: [yaml.get, root, "created_ms"] }] }]
                  - call: [yaml.free, doc]
                  - if:
                      condition: { gt: [out.len, 0] }
                      then:
                        - set: [out, "${out},"]
                  - set: [out, "${out}{\"id\":\"${sub_id}\",\"url\":${{ call: [museum.text.json_str, target] }},\"events\":${{ call: [museum.auth.csv_json, events_csv] }},\"created_ms\":${created}}"]
                  - set: [idx, { +: [idx, 1] }]
            - return: ["[${out}]"]

      # ── enqueue ──────────────────────────────────────────────────────────
      # Queues one delivery of `event` to subscription `sub_id`.
      - def:
          name: enqueue_one
          args: [[sub_id, string], [event, string], [data_json, string]]
          return: string
          body:
            - decl: [delivery, string, { call: [math.random_hex, 16] }]
            - decl: [now_ms, i64, { call: [time.now] }]
            - decl: [museum_json, string, { call: [museum.text.json_str, <.public_url] }]
            - decl: [payload, string, "{\"event\":${{ call: [museum.text.json_str, event] }},\"delivery\":\"${delivery}\",\"timestamp_ms\":${now_ms},\"museum\":${museum_json},\"data\":${data_json}}"]
            - decl: [log_dir, string, "${{ call: [<.hooks_dir] }}/log/${sub_id}"]
            - call: [museum.store.write_text, <.data_dir, log_dir, "${delivery}.body", payload]
            - call: [<.write_log, sub_id, delivery, event, "\"attempts\":0,\"status\":\"pending\",\"last_code\":0"]
            - call: [museum.store.write_text, <.data_dir, "${{ call: [<.hooks_dir] }}/queue", delivery, "{\"delivery\":\"${delivery}\",\"sub\":\"${sub_id}\",\"event\":${{ call: [museum.text.json_str, event] }},\"attempt\":0,\"next_ms\":0}"]
            - return: [delivery]

      # Fans `event` out to every subscription listening for it ("*" = all).
      - def:
          name: emit
          args: [[event, string], [data_json, string]]
          return: i32
          body:
            - decl: [ids, list<string>, { call: [museum.store.list_files, "${{ call: [<.hooks_dir] }}/subs"] }]
            - decl: [queued, i32, 0]
            - decl: [idx, i32, 0]
            - while:
                condition: { lt: [idx, ids.len] }
                body:
                  - decl: [sub_id, string, { call: [ids.get, idx] }]
                  - decl: [doc, ptr<yaml_doc>, { call: [yaml.parse_file, { call: [<.sub_path, sub_id] }] }]
                  - decl: [events_csv, string, { call: [museum.auth.seq_csv, { call: [yaml.get, { call: [yaml.root, doc] }, "events"] }] }]
                  - call: [yaml.free, doc]
                  - decl: [wanted, list<string>, { call: [museum.auth.csv_list, events_csv] }]
                  - if:
                      condition: { or: [{ eq: [{ call: [wanted.contains, "*"] }, 1] }, { eq: [{ call: [wanted.contains, event] }, 1] }] }
                      then:
                        - call: [<.enqueue_one, sub_id, event, data_json]
                        - set: [queued, { +: [queued, 1] }]
                  - set: [idx, { +: [idx, 1] }]
            - return: [queued]

      - def:
          name: write_log
          # `state` is the JSON fragment "attempts":N,"status":"..","last_code":C
          args: [[sub_id, string], [delivery, string], [event, string], [state, string]]
          body:
            - decl: [now_ms, i64, { call: [time.now] }]
            - call: [museum.store.write_text, <.data_dir, "${{ call: [<.hooks_dir] }}/log/${sub_id}", delivery, "{\"delivery\":\"${delivery}\",\"event\":${{ call: [museum.text.json_str, event] }},${state},\"updated_ms\":${now_ms}}"]

      - def:
          name: deliveries_json
          args: [[sub_id, string]]
          return: string
          body:
            - decl: [log_dir, string, "${{ call: [<.hooks_dir] }}/log/${sub_id}"]
            - decl: [files, list<string>, { call: [museum.store.list_files, log_dir] }]
            - decl: [out, string, ""]
            - decl: [idx, i32, 0]
            - while:
                condition: { lt: [idx, files.len] }
                body:
                  - decl: [name, string, { call: [files.get, idx] }]
                  - if:
                      condition: { eq: [{ call: [name.ends_with, ".body"] }, 0] }
                      then:
                        - if:
                            condition: { gt: [out.len, 0] }
                            then:
                              - set: [out, "${out},"]
                        - decl: [entry_json, string, { call: [museum.store.read_text, "${log_dir}/${name}"] }]
                        - set: [out, "${out}${entry_json}"]
                  - set: [idx, { +: [idx, 1] }]
            - return: ["[${out}]"]

      # Puts a logged delivery back on the queue (same delivery id and payload).
      - def:
          name: redeliver
          args: [[sub_id, string], [delivery, string]]
          return: i32
          body:
            - if:
                condition: { or: [{ eq: [{ call: [<.exists, sub_id] }, 0] }, { eq: [{ call: [museum.auth.valid_name, delivery] }, 0] }] }
                then:
                  - return: [0]
            - decl: [log_dir, string, "${{ call: [<.hooks_dir] }}/log/${sub_id}"]
            - if:
                condition: { not: [{ call: [io.exists, "${log_dir}/${delivery}.body"] }] }
                then:
                  - return: [0]
            - decl: [doc, ptr<yaml_doc>, { call: [yaml.parse_file, "${log_dir}/${delivery}"] }]
            - decl: [event, string, { call: [yaml.scalar, { call: [yaml.get, { call: [yaml.root, doc] }, "event"] }] }]
            - call: [yaml.free, doc]
            - call: [<.write_log, sub_id, delivery, event, "\"attempts\":0,\"status\":\"pending\",\"last_code\":0"]
            - call: [museum.store.write_text, <.data_dir, "${{ call: [<.hooks_dir] }}/queue", delivery, "{\"delivery\":\"${delivery}\",\"sub\":\"${sub_id}\",\"event\":${{ call: [museum.text.json_str, event] }},\"attempt\":0,\"next_ms\":0}"]
            - return: [1]

      # ── delivery (worker thread) ─────────────────────────────────────────
      # POSTs one payload; returns the HTTP status (0 = no response).
      - def:
          name: post
          args: [[target, string], [secret, string], [event, string], [delivery, string], [payload, string]]
          return: i32
          body:
            - decl: [dest, url, { call: [http.parse_url, target] }]
            - decl: [client, http_client_handle, { call: [http.new_request, "POST", dest] }]
            - decl: [signature, string, { call: [hash.hmac_sha256, secret, payload] }]
            - call: [client.headers.put, "Content-Type", "application/json"]
            - call: [client.headers.put, "X-Museum-Event", event]
            - call: [client.headers.put, "X-Museum-Delivery", delivery]
            - call: [client.headers.put, "X-Museum-Signature-256", "sha256=${signature}"]
            - call: [client.headers.put, "User-Agent", "museum-webhooks/1"]
            - set: [client.body, payload]
            - set: [client.timeout, 10000]
            - decl: [answer, http_response_handle, { call: [client.send] }]
            - if:
                condition: { eq: [answer, null] }
                then:
                  - return: [0]
            - decl: [code, i32, { call: [answer.status] }]
            - call: [answer.free]
            - return: [code]

      # One pass over the queue: delivers every due entry.  Returns how many
      # entries were attempted.
      - def:
          name: deliver_due
          return: i32
          body:
            - decl: [queue_dir, string, "${{ call: [<.hooks_dir] }}/queue"]
            - decl: [files, list<string>, { call: [museum.store.list_files, queue_dir] }]
            - decl: [now_ms, i64, { call: [time.now] }]
            - decl: [tried, i32, 0]
            - decl: [idx, i32, 0]
            - while:
                condition: { lt: [idx, files.len] }
                body:
                  - decl: [delivery, string, { call: [files.get, idx] }]
                  - decl: [qpath, string, "${queue_dir}/${delivery}"]
                  - decl: [doc, ptr<yaml_doc>, { call: [yaml.parse_file, qpath] }]
                  - decl: [root, ptr<yaml_node>, { call: [yaml.root, doc] }]
                  - decl: [sub_id, string, { call: [yaml.scalar, { call: [yaml.get, root, "sub"] }] }]
                  - decl: [event, string, { call: [yaml.scalar, { call: [yaml.get, root, "event"] }] }]
                  - decl: [attempt, i32, { call: [yaml.scalar, { call: [yaml.get, root, "attempt"] }] }]
                  - decl: [next_ms, i64, { call: [yaml.scalar, { call: [yaml.get, root, "next_ms"] }] }]
                  - call: [yaml.free, doc]
                  - if:
                      condition: { le: [next_ms, now_ms] }
                      then:
                        - call: [<.attempt, qpath, sub_id, delivery, event, attempt]
                        - set: [tried, { +: [tried, 1] }]
                  - set: [idx, { +: [idx, 1] }]
            - return: [tried]

      - def:
          name: attempt
          args: [[qpath, string], [sub_id, string], [delivery, string], [event, string], [attempt, i32]]
          body:
            # Subscription deleted meanwhile: the delivery is dropped.
            - if:
                condition: { eq: [{ call: [<.exists, sub_id] }, 0] }
                then:
                  - call: [io.remove, qpath]
                  - return: []
            - decl: [doc, ptr<yaml_doc>, { call: [yaml.parse_file, { call: [<.sub_path, sub_id] }] }]
            - decl: [root, ptr<yaml_node>, { call: [yaml.root, doc] }]
            - decl: [target, string, { call: [yaml.scalar, { call: [yaml.get, root, "url"] }] }]
            - decl: [secret, string, { call: [yaml.scalar, { call: [yaml.get, root, "secret"] }] }]
            - call: [yaml.free, doc]
            - decl: [payload, string, { call: [io.read_file, "${{ call: [<.hooks_dir] }}/log/${sub_id}/${delivery}.body"] }]
            - decl: [code, i32, { call: [<.post, target, secret, event, delivery, payload] }]
            - decl: [done, i32, { +: [attempt, 1] }]
            - if:
                condition: { and: [{ ge: [code, 200] }, { lt: [code, 300] }] }
                then:
                  - call: [<.write_log, sub_id, delivery, event, "\"attempts\":${done},\"status\":\"delivered\",\"last_code\":${code}"]
                  - call: [io.remove, qpath]
                  - return: []
            - decl: [wait_ms, i64, { call: [museum.hooks.backoff_ms, done] }]
            - if:
                condition: { lt: [wait_ms, 0] }
                then:
                  - call: [<.write_log, sub_id, delivery, event, "\"attempts\":${done},\"status\":\"failed\",\"last_code\":${code}"]
                  - call: [io.remove, qpath]
                  - call: [log.warn, "webhook ${delivery} (${event}) to ${target} failed after ${done} attempts"]
                  - return: []
            - decl: [next_ms, i64, { +: [{ call: [time.now] }, wait_ms] }]
            - call: [<.write_log, sub_id, delivery, event, "\"attempts\":${done},\"status\":\"retrying\",\"last_code\":${code}"]
            - call: [museum.store.write_text, <.data_dir, "${{ call: [<.hooks_dir] }}/queue", delivery, "{\"delivery\":\"${delivery}\",\"sub\":\"${sub_id}\",\"event\":${{ call: [museum.text.json_str, event] }},\"attempt\":${done},\"next_ms\":${next_ms}}"]

# Delivery worker: runs on its own thread for the lifetime of the server.
- def:
    name: worker_loop
    args: [[data_dir, string], [public_url, string]]
    body:
      - decl: [hub, ptr<museum.hooks.WebhookHub>, { new: museum.hooks.WebhookHub }]
      - set: [hub.data_dir, data_dir]
      - set: [hub.public_url, public_url]
      - decl: [running, i32, 1]
      - while:
          condition: { eq: [running, 1] }
          body:
            - call: [hub.deliver_due]
            - call: [time.sleep_ms, 250]
