# Scheduled retention (web_ui.md FW-45): checks every 30 s whether the
# policy's daily time has come.
- def:
    name: retention_loop
    body:
      - decl: [running, i32, 1]
      - while:
          condition: { eq: [running, 1] }
          body:
            - call: [time.sleep_ms, 30000]
            - call: [g_lock.acquire]
            - call: [g_api.retention_tick]
            - call: [g_lock.release]

