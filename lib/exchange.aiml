# kontor.http — one request/response pair with the helpers handlers need.

- namespace: kontor.http

- import: "text.aiml"

# Machine-readable error code for an HTTP status (JSON errors {"error","code"}).
- def:
    name: error_code
    args: [[status, i32]]
    return: string
    body:
      - decl: [codes, map<i32:string>, { 400: "bad_request", 401: "unauthorized", 403: "forbidden", 404: "not_found", 405: "method_not_allowed", 409: "conflict", 413: "too_large", 416: "range_invalid", 422: "invalid", 500: "internal", 501: "not_implemented", 507: "insufficient_storage" }]
      - if:
          condition: { eq: [{ call: [codes.contains, status] }, 1] }
          then:
            - return: [{ call: [codes.get, status] }]
      - return: ["error"]

- class:
    name: Exchange
    members:
      - [req, http_request_handle, null, { access: public }]
      - [resp, http_response_handle, null, { access: public }]
    methods:
      # Named route segment ("/exodus/:name/...") or "".
      - def:
          name: param
          args: [[key, string]]
          return: string
          body:
            - decl: [params, map<string:string>]
            - set: [params, <.req.params]
            - decl: [val, string, { call: [params.get, key] }]
            - if:
                condition: { eq: [val, null] }
                then:
                  - return: [""]
            - return: [val]

      # Query parameter or "".
      - def:
          name: query
          args: [[key, string]]
          return: string
          body:
            - decl: [qurl, url]
            - set: [qurl, <.req.url]
            - decl: [val, string, { call: [qurl.get_param.get, key] }]
            - if:
                condition: { eq: [val, null] }
                then:
                  - return: [""]
            - return: [val]

      # Request header (lower-case name) or "".
      - def:
          name: header
          args: [[key, string]]
          return: string
          body:
            - decl: [inreq, http_request_handle, <.req]
            - decl: [val, string, { call: [inreq.header, key] }]
            - if:
                condition: { eq: [val, null] }
                then:
                  - return: [""]
            - return: [val]

      - def:
          name: path
          return: string
          body:
            - decl: [inreq, http_request_handle, <.req]
            - return: [inreq.path]

      # Body as text ("" when empty).  A spooled body (srv.set_spool) is read
      # from its temp file.
      - def:
          name: text
          return: string
          body:
            - decl: [inreq, http_request_handle, <.req]
            - decl: [spooled, string, inreq.body_path]
            - if:
                condition: { neq: [spooled, null] }
                then:
                  - return: [{ call: [io.read_file, spooled] }]
            - decl: [val, string, inreq.body]
            - if:
                condition: { eq: [val, null] }
                then:
                  - return: [""]
            - return: [val]

      # Exact body length in bytes.
      - def:
          name: body_len
          return: i64
          body:
            - decl: [inreq, http_request_handle, <.req]
            - return: [inreq.body_len]

      # The body as a file: the spooled temp file is moved to `dest`, an
      # in-memory body is written there (binary-safe).  Returns 0 on success.
      # An empty body creates an empty file.
      - def:
          name: body_to_file
          args: [[dest, string]]
          return: i32
          body:
            - decl: [inreq, http_request_handle, <.req]
            - decl: [spooled, string, inreq.body_path]
            - if:
                condition: { neq: [spooled, null] }
                then:
                  - call: [io.rename, spooled, dest]
                  - if:
                      condition: { call: [io.exists, dest] }
                      then:
                        - return: [0]
                  - return: [-1]
            - decl: [payload, buffer<u8>]
            - set: [payload, inreq.body_bytes]
            - return: [{ call: [io.write_file, dest, payload] }]

      # Status with an empty body (202/204/201 of the registry protocol).
      - def:
          name: empty
          args: [[status, i32]]
          body:
            - decl: [out, http_response_handle, <.resp]
            - set: [out.status, status]
            - set: [out.body, ""]
            - call: [out.send]

      - def:
          name: json
          args: [[status, i32], [payload, string]]
          body:
            - decl: [out, http_response_handle, <.resp]
            - call: [out.headers.put, "content-type", "application/json"]
            - set: [out.status, status]
            - set: [out.body, "${payload}\n"]
            - call: [out.send]

      - def:
          name: error
          args: [[status, i32], [message, string]]
          body:
            - decl: [msg_json, string, { call: [kontor.text.json_str, message] }]
            - decl: [code, string, { call: [kontor.http.error_code, status] }]
            - call: [<.json, status, "{\"error\":${msg_json},\"code\":\"${code}\"}"]

      # Streams a file (Range-aware) with the given content type.
      - def:
          name: file
          args: [[file_path, string], [content_type, string]]
          body:
            - decl: [out, http_response_handle, <.resp]
            - call: [out.headers.put, "content-type", content_type]
            - set: [out.body_file, file_path]
            - call: [out.send]

      - def:
          name: set_header
          args: [[key, string], [val, string]]
          body:
            - decl: [out, http_response_handle, <.resp]
            - call: [out.headers.put, key, val]

      # 302 to `target` (no body, not cached).
      - def:
          name: redirect
          args: [[target, string]]
          body:
            - decl: [out, http_response_handle, <.resp]
            - call: [out.headers.put, "location", target]
            - call: [out.headers.put, "cache-control", "no-store"]
            - set: [out.status, 302]
            - set: [out.body, ""]
            - call: [out.send]

      # One field of an application/x-www-form-urlencoded body (the SAML POST
      # binding); the URL parser does the percent-decoding.
      - def:
          name: form
          args: [[key, string]]
          return: string
          body:
            - decl: [raw, string, { call: [<.text] }]
            - decl: [furl, url, { call: [http.parse_url, "http://form.invalid/?${raw}"] }]
            - decl: [val, string, { call: [furl.get_param.get, key] }]
            - if:
                condition: { eq: [val, null] }
                then:
                  - return: [""]
            - return: [val]
